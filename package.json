{
  "name": "pi-virtual-employee",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Desktop virtual-employee app (Electron) built on the pi agent SDK (@earendil-works/pi-agent-core).",
  "author": "Pi Virtual Employee",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "prepare:native:win": "node scripts/prepare-win-native.mjs",
    "package:win": "npm run typecheck && npm run build && npm run prepare:native:win && electron-builder --win nsis --x64",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "ali-oss": "^6.23.0",
    "better-sqlite3": "^11.7.0",
    "cron-parser": "^5.7.0",
    "dingtalk-stream": "^2.1.6-beta.1",
    "mammoth": "^1.12.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "sqlite-vec": "^0.1.9",
    "typebox": "^1.1.38",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/ali-oss": "^6.23.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "node-abi": "^3.94.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "build": {
    "appId": "com.pi.virtualemployee",
    "productName": "Pi Virtual Employee",
    "artifactName": "Pi-Virtual-Employee-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "renderer/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/native-win",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pi Virtual Employee"
    }
  }
}
