{
	"name": "pi-virtual-employee",
	"private": true,
	"type": "module",
	"version": "0.2.73",
	"description": "Desktop virtual-employee app (Electron) built on the pi agent SDK (@earendil-works/pi-agent-core).",
	"author": "Pi Virtual Employee",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "vite build && node scripts/build-electron.mjs",
		"typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
		"test:shell": "node --test scripts/test-shell-timeout.mjs",
		"test:computer": "node --test scripts/test-computer.mjs",
		"test:permissions": "node --test scripts/test-permissions.mjs",
		"test:browser": "node --test scripts/test-browser-canvas.mjs",
		"test:prompt": "node --test scripts/test-prompt.mjs",
		"test:all": "node scripts/run-all-tests.mjs",
		"verify:immutable": "node scripts/verify-immutable.mjs",
		"test:scheduler": "node --test scripts/test-scheduler.mjs",
		"test:telemetry": "node --test scripts/test-telemetry.mjs",
		"test:immutable": "node --test scripts/test-immutable.mjs",
		"test:proposals": "node --test scripts/test-proposals.mjs",
		"test:prompt-lab": "node --test scripts/test-prompt-lab.mjs",
		"test:context": "node --test scripts/test-context.mjs",
		"test:im-commands": "node --test scripts/test-im-commands.mjs",
		"test:authorization": "node --test scripts/test-authorization.mjs",
		"test:watchdog": "node --test scripts/test-watchdog.mjs",
		"prepare:native:win": "node scripts/prepare-win-native.mjs",
		"prepare:native:linux": "node scripts/prepare-linux-native.mjs",
		"package:win": "npm run typecheck && npm run build && npm run prepare:native:win && electron-builder --win nsis --x64",
		"package:linux": "npm run typecheck && npm run build && npm run prepare:native:linux && electron-builder --linux AppImage --x64",
		"release": "node scripts/publish.mjs",
		"release:dry": "node scripts/publish.mjs --dry-run",
		"postinstall": "electron-rebuild -f -w better-sqlite3"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.83.0",
		"@earendil-works/pi-ai": "^0.83.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@types/adm-zip": "^0.5.8",
		"adm-zip": "^0.6.0",
		"ali-oss": "^6.23.0",
		"better-sqlite3": "^11.7.0",
		"cron-parser": "^5.7.0",
		"dingtalk-stream": "^2.1.6-beta.1",
		"electron-updater": "^6.8.9",
		"mammoth": "^1.12.0",
		"marked": "^18.0.11",
		"playwright": "^1.62.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-markdown": "^9.0.1",
		"sqlite-vec": "^0.1.9",
		"typebox": "^1.1.38",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@electron/rebuild": "^3.7.1",
		"@types/ali-oss": "^6.23.3",
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "^22.19.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"electron": "^33.2.1",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.21.5",
		"node-abi": "^3.94.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.9.0",
		"vite": "^5.4.11",
		"vite-plugin-electron": "^0.28.8",
		"vite-plugin-electron-renderer": "^0.14.6"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"build": {
		"appId": "com.pi.virtualemployee",
		"productName": "Pi Virtual Employee",
		"artifactName": "Pi-Virtual-Employee-Setup-${version}-${arch}.${ext}",
		"directories": {
			"output": "release"
		},
		"publish": [
			{
				"provider": "generic",
				"url": "https://gitee.com/xiaoliu10/pi-virtual-employee/releases/download/latest"
			}
		],
		"files": [
			"dist-electron/**/*",
			"renderer/dist/**/*",
			"node_modules/**/*",
			"package.json"
		],
		"asarUnpack": [
			"node_modules/better-sqlite3/**/*"
		],
		"npmRebuild": false,
		"nodeGypRebuild": false,
		"win": {
			"extraResources": [
				{
					"from": "build/native-win",
					"to": "native",
					"filter": [
						"**/*"
					]
				}
			],
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"artifactName": "Pi-Virtual-Employee-Setup-${version}-${arch}.${ext}"
		},
		"nsis": {
			"oneClick": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Pi Virtual Employee"
		},
		"linux": {
			"extraResources": [
				{
					"from": "build/native-linux",
					"to": "native",
					"filter": [
						"**/*"
					]
				}
			],
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64"
					]
				}
			],
			"category": "Office",
			"artifactName": "Pi-Virtual-Employee-${version}-${arch}.${ext}",
			"maintainer": "Pi Virtual Employee"
		}
	}
}
