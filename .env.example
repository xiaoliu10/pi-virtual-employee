# Which LLM provider to use: "anthropic" or "openai"
PROVIDER=anthropic

# Model id within the provider's registry (see pi-ai MODELS).
# Anthropic examples: claude-sonnet-4-5 | claude-haiku-4-5-20251001
# OpenAI examples:    gpt-5 | gpt-4o
MODEL_ID=claude-sonnet-4-5

# API keys — set the one matching PROVIDER (pi-ai reads these automatically).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# HTTP server port
PORT=3000

# Gitee personal access token — used by `npm run release` to rebuild the
# `latest` release (delete + recreate + upload Windows & Linux installers).
# Generate at https://gitee.com/profile/personal_access_tokens — scope: projects.
# .env is git-ignored; never commit a real token. Per-run override:
#   GITEE_TOKEN=xxx npm run release
GITEE_TOKEN=
