# Which LLM provider to use: "anthropic" or "openai"
PROVIDER=anthropic

# Model id within the provider's registry (see pi-ai MODELS).
# Anthropic examples: claude-sonnet-4-5 | claude-haiku-4-5-20251001
# OpenAI examples:    gpt-5 | gpt-4o
MODEL_ID=claude-sonnet-4-5

# API keys — set the one matching PROVIDER (pi-ai reads these automatically).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# HTTP server port
PORT=3000
